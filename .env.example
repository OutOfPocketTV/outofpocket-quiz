# Global Dream Partner Report -- required environment variables.
#
# Set these in Vercel: Project -> Settings -> Environment Variables.
# Never commit real values or paste secret keys into chat -- Claude
# never needs to see them, the code only reads process.env.*.

# Stripe (test-mode keys while developing; switch to live keys at launch)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_GLOBAL_REPORT_PRICE_ID=price_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Database (auto-populated if you add Vercel Postgres via the Vercel
# dashboard's Storage tab -- no manual entry needed in that case)
POSTGRES_URL=

# Email (Resend) -- sends the buyer their access link on purchase, and
# again if they ask to restore access on a new device. Get an API key at
# resend.com; EMAIL_FROM must be a verified sender/domain in that account
# (Resend's shared onboarding@resend.dev works for testing before your
# domain is verified).
RESEND_API_KEY=re_...
EMAIL_FROM=Out Of Pocket TV <reports@outofpocket.tv>
