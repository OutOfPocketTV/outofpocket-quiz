# Global Dream Partner Report -- required environment variables.
#
# Set these in Vercel: Project -> Settings -> Environment Variables.
# Never commit real values or paste secret keys into chat -- Claude
# never needs to see them, the code only reads process.env.*.

# Stripe (test-mode keys while developing; switch to live keys at launch)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_GLOBAL_REPORT_PRICE_ID=price_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Database (auto-populated if you add Vercel Postgres via the Vercel
# dashboard's Storage tab -- no manual entry needed in that case)
POSTGRES_URL=

# Email (Resend) -- sends the buyer their access link on purchase, and
# again if they ask to restore access on a new device. Get an API key at
# resend.com; EMAIL_FROM must be a verified sender/domain in that account
# (Resend's shared onboarding@resend.dev works for testing before your
# domain is verified).
RESEND_API_KEY=re_...
EMAIL_FROM=Out Of Pocket TV <reports@outofpocket.tv>

# Analytics dashboard (/dashboard.html) -- pulls real numbers from the
# GA4 property already wired into index.html/script.js (G-BQPW0R8CEJ).
# Setup, all free:
#   1. console.cloud.google.com -> create a project (or reuse one) ->
#      "APIs & Services" -> Library -> enable "Google Analytics Data API".
#   2. "APIs & Services" -> Credentials -> Create Credentials -> Service
#      Account -> give it any name, no roles needed here -> Done.
#   3. Open the new service account -> Keys tab -> Add Key -> Create new
#      key -> JSON. This downloads a .json file -- never commit it.
#   4. In Google Analytics (analytics.google.com), go to Admin -> your
#      GA4 property -> Property Access Management -> "+" -> Add users.
#      Paste the service account's "client_email" (from the JSON) and
#      grant it "Viewer".
#   5. Also in Admin -> Property Settings, copy the numeric "Property ID"
#      (NOT the "G-XXXXXXX" Measurement ID) into GOOGLE_ANALYTICS_PROPERTY_ID.
#   6. Copy client_email and private_key straight out of the downloaded
#      JSON into the two vars below. Paste the private_key exactly as-is,
#      including the literal \n sequences and the BEGIN/END lines -- the
#      code un-escapes them at runtime.
GOOGLE_ANALYTICS_PROPERTY_ID=123456789
GOOGLE_ANALYTICS_CLIENT_EMAIL=dashboard@your-project.iam.gserviceaccount.com
GOOGLE_ANALYTICS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Password gate for /dashboard.html -- pick anything, this is the only
# thing standing between the public internet and your funnel/revenue
# numbers, so don't reuse a password from elsewhere.
DASHBOARD_PASSWORD=
