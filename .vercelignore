# Blog generator and checks: run locally / by the scheduled post task, never served.
/blog-tools

# Tooling that never runs on Vercel and should not be downloadable from the site.
# comment-bot/ and lib/ stay: api/live-status.js requires them at request time.
/discord
/sql
/.github
/.env.example

# Stream tooling runs on the streaming PC: stream/relay.js serves the
# overlays and console from disk on 127.0.0.1, and the console loads the
# engine from there too. The website only ever loads stream/bridge.js
# (with ?stream=1), so that one file is kept and the rest stays off it.
/stream/*
!/stream/bridge.js
